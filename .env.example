# Copie este archivo a `.env` y ajuste los valores. `.env` NO se versiona.

# --- Obligatorio -----------------------------------------------------------
# Use un rol de SOLO LECTURA, nunca el superusuario: es la unica barrera que
# no depende de que el validador sea perfecto. Ver docs/DESPLIEGUE.md.
BI_DATABASE_URL=postgresql+psycopg2://bi_lector:CAMBIEME@db:5432/erp

# --- Modelo ----------------------------------------------------------------
BI_OLLAMA_URL=http://host.docker.internal:11434
# "qwen2.5-coder:3b" por omision: medido de verdad contra dos preguntas con
# JOIN reales (empleado que mas vendio, total por categoria) -- ambas
# correctas al centavo, 60-100s cada una. El "7b" es mas preciso en teoria,
# pero en la misma maquina, con los dos modelos cargados a la vez en RAM,
# TIMEOUT a los 270s las dos veces -- el chico aguanta mejor la CPU
# compartida, no solo es mas rapido en condiciones ideales. Para preguntas
# mas dificiles que un JOIN de dos tablas, pruebe "qwen2.5-coder:7b" primero
# con sus propias preguntas antes de confiar en el chico a ciegas.
#
# El tag debe ser EXACTO al que baje con `ollama pull` (`ollama list`):
# "qwen2.5-coder:7b" y "qwen2.5-coder:7b-instruct" son el mismo modelo en el
# registro pero Ollama los trata como pulls distintos -- si aqui dice uno que
# no bajo, la consulta falla con "modelo no encontrado" aunque /health diga
# que esta disponible.
BI_MODEL=qwen2.5-coder:3b
# Medido de verdad, no estimado: 90-100s en CPU pura, 166s dentro de Docker
# con otros contenedores compitiendo por CPU. Con GPU responde en segundos.
BI_LLM_TIMEOUT=270

# --- Que ve el modelo ------------------------------------------------------
# Vacio = todas las tablas menos la lista negra por omision.
# Recomendado en produccion: nombrar explicitamente lo consultable.
BI_INCLUDE_TABLES=
BI_EXCLUDE_TABLES=
BI_HIDDEN_COLUMNS=
BI_MAX_TABLES=60
BI_SAMPLE_VALUES=0

# --- Limites ---------------------------------------------------------------
BI_ROW_LIMIT=1000
BI_SQL_TIMEOUT_MS=15000
BI_MAX_WIDGETS=8
BI_SCHEMA_TTL=300
# Cuanto se reusa el JSON de una pregunta IDENTICA (misma redaccion, mismo
# esquema) antes de volver a pensarla con el modelo. La primera vez tarda lo
# de siempre (45-100s en CPU); repetirla mientras el TTL siga vivo contesta
# en milisegundos -- pensado para una demo que repite las mismas preguntas de
# ejemplo. Nunca cachea datos: el SQL se re-ejecuta fresco cada vez. 0 lo apaga.
BI_QUESTION_CACHE_TTL=3600

# --- Servidor --------------------------------------------------------------
# 8090 y no 8080: en mas de una maquina de prueba el 8080 ya estaba tomado por
# el nginx de OTRO proyecto. Si 8090 tambien choca, use otro puerto libre.
BI_PUERTO=8090
