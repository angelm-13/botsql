# Copie este archivo a `.env` y ajuste los valores. `.env` NO se versiona.

# --- Obligatorio -----------------------------------------------------------
# Use un rol de SOLO LECTURA, nunca el superusuario: es la unica barrera que
# no depende de que el validador sea perfecto. Ver docs/DESPLIEGUE.md.
BI_DATABASE_URL=postgresql+psycopg2://bi_lector:CAMBIEME@db:5432/erp

# --- Modelo ----------------------------------------------------------------
BI_OLLAMA_URL=http://host.docker.internal:11434
# El tag "qwen2.5-coder:7b-instruct" tambien existe en el registro y es el
# mismo modelo, pero use el que YA tenga descargado (`ollama list`): Ollama
# compara el tag exacto, y si aqui dice uno distinto al que bajo, la consulta
# falla con "modelo no encontrado" aunque /health diga que esta disponible.
BI_MODEL=qwen2.5-coder:7b
# Medido de verdad, no estimado: 90-100s en CPU pura, 166s dentro de Docker
# con otros contenedores compitiendo por CPU. Con GPU responde en segundos.
BI_LLM_TIMEOUT=270

# --- Que ve el modelo ------------------------------------------------------
# Vacio = todas las tablas menos la lista negra por omision.
# Recomendado en produccion: nombrar explicitamente lo consultable.
BI_INCLUDE_TABLES=
BI_EXCLUDE_TABLES=
BI_HIDDEN_COLUMNS=
BI_MAX_TABLES=60
BI_SAMPLE_VALUES=0

# --- Limites ---------------------------------------------------------------
BI_ROW_LIMIT=1000
BI_SQL_TIMEOUT_MS=15000
BI_MAX_WIDGETS=8
BI_SCHEMA_TTL=300

# --- Servidor --------------------------------------------------------------
# 8090 y no 8080: en mas de una maquina de prueba el 8080 ya estaba tomado por
# el nginx de OTRO proyecto. Si 8090 tambien choca, use otro puerto libre.
BI_PUERTO=8090
