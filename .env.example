# Copiar como .env y ajustar valores antes de "docker compose up"

# --- General ---
TZ=America/Mexico_City

# --- Base de datos (Postgres) ---
DB_NAME=tyakxa_erp
DB_USER=tyakxa_user
DB_PASSWORD=tyakxa_password
DB_HOST=db
DB_PORT=5432
DB_PUBLIC_PORT=5433

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://

# --- Backend (Flask) ---
BACKEND_PORT=5001
SECRET_KEY=change-me
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_MINUTES=480
DEFAULT_LOCALE=es
UPLOAD_ROOT=/uploads
DOCUMENTS_REPORTS_APP_PATH=/documents-reports/app
DOCUMENTS_TEMPLATES_DIR=/documents-reports/templates

# Bootstrap del admin inicial
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin1

# MFA
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Tyakxa
MFA_ISSUER_NAME=Tyakxa ERP
MFA_TEMP_TOKEN_MINUTES=5

# Correo (reset de password, etc.)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Tienda pública (JWT scope)
PUBLIC_JWT_SCOPE=web_shopper
PUBLIC_JWT_TTL_HOURS=24
PUBLIC_FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=60

# --- Frontend (Vite) ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:5001

# --- NGINX ---
NGINX_HTTP_PORT=8080
SERVER_NAME=localhost
