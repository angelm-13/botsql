BACKEND_PORT=5001
# Local en UNA sola computadora: se puede usar URL absoluta. En VPS, o si se va
# a entrar desde otras computadoras de la misma red local (http://<IP>:3001),
# dejar vacío para usar /api -Vite lo proxea en dev, NGINX en el VPS-: con una
# URL absoluta a "localhost" cualquier otra máquina intenta pegarle a SU
# PROPIO localhost, y eso se ve en el navegador como un bloqueo de CORS aunque
# el problema real es que ahí no hay nada escuchando.
VITE_API_BASE_URL=
