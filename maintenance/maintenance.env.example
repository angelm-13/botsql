# TYAKXA Maintenance Environment
PROJECT_NAME=tyakxa_project
COMPOSE_PROJECT_NAME=tyakxa

# Docker compose file. Leave empty to auto-detect.
COMPOSE_FILE=

# PostgreSQL
DB_SERVICE=db
DB_HOST=db
DB_PORT=5432
DB_NAME=tyakxa_erp
DB_USER=tyakxa_user
DB_PASSWORD=change_me

# Backups
BACKUP_DIR=./maintenance/backups
BACKUP_RETENTION_DAYS=14
BACKUP_PREFIX=tyakxa_pg

# URLs
BACKEND_HEALTH_URL=http://localhost:5001/health
FRONTEND_URL=http://localhost:3000
RABBITMQ_AMQP_HOST=localhost
RABBITMQ_AMQP_PORT=5672
